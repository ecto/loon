; ─────────────────────────────────────────────────────────────────────────
; loon-hdl — synchronous FIFO: the DMA prefetch / skid buffer.
; Composes the memory-array primitive (ram.oo) into a real streaming block:
; a Mem buffer + head/tail pointers (indexed write/read) + a count register
; for full/empty. This is the buffer that hides PCIe/NVMe latency so the
; systolic array never stalls. Co-sim'd bit-exact against a pure-Loon queue.
; Depth must be a power of two (pointers wrap on their own bit width).
; ─────────────────────────────────────────────────────────────────────────

[fn clog2-go [n acc] [if [<= n 1] acc [clog2-go [/ [+ n 1] 2] [+ acc 1]]]]
[fn clog2 [n] [clog2-go n 0]]

; ── L0 IR  (BinOp += And, Eq; Index/Mem/MemNb from the memory primitive) ─
[type BinOp Add Sub And Eq]
[type Expr [Ref String] [Lit Int] [Bin BinOp Expr Expr] [Index String Expr]]
[type Dir In Out]
[type Kind Wire Reg]
[type Port [Port Dir Kind Int String]]
[type Decl [Net Kind Int String] [Mem Int Int String]]
[type Seq [Nb String Expr] [MemNb String Expr Expr] [If Expr (Vec Seq) (Vec Seq)]]
[type Stmt [Assign String Expr] [Always String (Vec Seq)]]
[type Module [Module String (Vec Port) (Vec Decl) (Vec Stmt)]]

; ── emitter ──────────────────────────────────────────────────────────────
[fn bin-sym  [op] [match op Add "+" Sub "-" And "&" Eq "=="]]
[fn dir-str  [d]  [match d In "input " Out "output"]]
[fn kind-str [k]  [match k Wire "wire" Reg "reg "]]
[fn range-str [w] [if [= w 1] "" [str "[" [- w 1] ":0] "]]]
[fn emit-expr [e]
  [match e
    [Ref n]      n
    [Lit v]      [str v]
    [Bin op a b] [str "(" [emit-expr a] " " [bin-sym op] " " [emit-expr b] ")"]
    [Index m i]  [str m "[" [emit-expr i] "]"]]]
[fn emit-port [p]
  [match p [Port d k w n] [str "  " [dir-str d] " " [kind-str k] " " [range-str w] n]]]
[fn emit-decl [d]
  [match d
    [Net k w n]  [str "  " [kind-str k] " " [range-str w] n ";\n"]
    [Mem w dp n] [str "  reg " [range-str w] n " [0:" [- dp 1] "];\n"]]]
[fn emit-seq [s ind]
  [match s
    [Nb lhs e]    [str ind lhs " <= " [emit-expr e] ";"]
    [MemNb m i e] [str ind m "[" [emit-expr i] "] <= " [emit-expr e] ";"]
    [If c t e]
      [if [= [len e] 0]
        [str ind "if (" [emit-expr c] ") begin\n"
             [join "\n" [map [fn [x] [emit-seq x [str ind "  "]]] t]] "\n" ind "end"]
        [str ind "if (" [emit-expr c] ") begin\n"
             [join "\n" [map [fn [x] [emit-seq x [str ind "  "]]] t]]
             "\n" ind "end else begin\n"
             [join "\n" [map [fn [x] [emit-seq x [str ind "  "]]] e]]
             "\n" ind "end"]]]]
[fn emit-stmt [s]
  [match s
    [Assign lhs e] [str "  assign " lhs " = " [emit-expr e] ";"]
    [Always clk body]
      [str "  always @(posedge " clk ") begin\n"
           [join "\n" [map [fn [x] [emit-seq x "    "]] body]] "\n  end"]]]
[fn emit-module [m]
  [match m [Module name ports decls stmts]
    [str "module " name " (\n" [join ",\n" [map emit-port ports]] "\n);\n"
         [join "" [map emit-decl decls]] [join "\n" [map emit-stmt stmts]]
         "\nendmodule\n"]]]

; ── generator : (width depth) -> a synchronous FIFO Module ──────────────
[fn fifo [width depth]
  [let aw [clog2 depth]]
  [let cw [+ aw 1]]
  [let ports
    #[[Port In Wire 1 "clk"] [Port In Wire 1 "rst"]
      [Port In Wire 1 "push"] [Port In Wire 1 "pop"]
      [Port In Wire width "wdata"] [Port Out Wire width "rdata"]
      [Port Out Wire 1 "full"] [Port Out Wire 1 "empty"]]]
  [let decls
    #[[Mem width depth "mem"]
      [Net Reg aw "head"] [Net Reg aw "tail"] [Net Reg cw "count"]
      [Net Wire 1 "do_push"] [Net Wire 1 "do_pop"]]]
  [let rst-blk #[[Nb "head" [Lit 0]] [Nb "tail" [Lit 0]] [Nb "count" [Lit 0]]]]
  [let push-blk #[[MemNb "mem" [Ref "tail"] [Ref "wdata"]]
                  [Nb "tail" [Bin Add [Ref "tail"] [Lit 1]]]]]
  [let run-blk #[[If [Ref "do_push"] push-blk #[]]
                 [If [Ref "do_pop"] #[[Nb "head" [Bin Add [Ref "head"] [Lit 1]]]] #[]]
                 [Nb "count" [Bin Sub [Bin Add [Ref "count"] [Ref "do_push"]] [Ref "do_pop"]]]]]
  [let abody #[[If [Ref "rst"] rst-blk run-blk]]]
  [let stmts
    #[[Assign "full"    [Bin Eq [Ref "count"] [Lit depth]]]
      [Assign "empty"   [Bin Eq [Ref "count"] [Lit 0]]]
      [Assign "do_push" [Bin And [Ref "push"] [Bin Eq [Ref "full"] [Lit 0]]]]
      [Assign "do_pop"  [Bin And [Ref "pop"] [Bin Eq [Ref "empty"] [Lit 0]]]]
      [Assign "rdata"   [Index "mem" [Ref "head"]]]
      [Always "clk" abody]]]
  [Module [str "fifo_" width "x" depth] ports decls stmts]]

; ── golden model: pure-Loon queue (append-log + head index, closure-free) ─
[fn run-go [cmds i log head outs]
  [if [>= i [len cmds]] outs
    [do
      [let c [nth cmds i]]
      [if [= [nth c 0] 1]
        [run-go cmds [+ i 1] [conj log [nth c 1]] head outs]
        [run-go cmds [+ i 1] log [+ head 1] [conj outs [nth log head]]]]]]]
[fn run-fifo [cmds] [run-go cmds 0 #[] 0 #[]]]

[fn main []
  [println "=== loon-hdl: synchronous FIFO (composes the memory primitive) ==="]
  [println [emit-module [fifo 8 8]]]
  [println "=== golden: pop sequence for push 11,22,33,44 then 4 pops ==="]
  [let cmds #[#[1 11] #[1 22] #[1 33] #[1 44] #[0] #[0] #[0] #[0]]]
  [println [str "  pops = " [run-fifo cmds]]]]
