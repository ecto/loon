; ───────────────────────────────────────────────────────────────────────────
; Durable execution as a handler — checkpoint & resume for an agent.
;
; Eve (Vercel's agent framework) makes durable execution a headline feature:
; every step is checkpointed so a session can pause, survive a crash, and resume
; where it left off — built on a separate Workflow SDK. On an effect substrate
; that falls out as an ordinary handler: record each effect's result to a
; journal, and to resume, REPLAY the journal (returning recorded results without
; re-performing the side effects) until it is exhausted, then go live. The agent
; loop is unchanged — only the tower differs.
;
; Below, the journal is a vector of effect results in order. `run-resume` threads
; it as the handler's answer; each effect pops the next recorded result (replay)
; or, once the journal is empty, performs the live action. A journal truncated by
; a "crash" replays its prefix and then continues live to the same final state.
;
; (The symmetric recorder — a tower that threads a GROWING journal and appends
; each result — produces these journals; resume is the interesting half.)
;
; Run:   loon run   src/agent/durable.oo
; Check: loon check src/agent/durable.oo
; ───────────────────────────────────────────────────────────────────────────
[effect Llm
  [complete [String] String]]

[effect Tool
  [call [String] String]]

[effect Log
  [info [String] Unit]]

; The agent loop — plain code performing effects, identical under every tower.
[fn agent [step history]
  [let action [Llm.complete [str step]]]
  [if [= action "done"]
    history
    [do
      [let label [str history " " action]]
      [let r [Tool.call action]]
      [agent [+ step 1] [str label ":" r]]]]]

[fn live-llm [p]
  [match p
    "0" "search"
    "1" "summarize"
    _ "done"]]

[fn live-tool [t]
  [match t
    "search" "3-hits"
    "summarize" "summary"
    _ "ok"]]

; LIVE tower: deterministic, no journal.
[fn run-live []
  [handle
    [agent 0 "start"]
    [Llm.complete p]
    [resume [live-llm p]]
    [Tool.call t]
    [resume [live-tool t]]
    [Log.info m]
    [resume []]]]

; RESUME tower: replay a persisted journal of effect results, then go live once
; it is exhausted. The journal is threaded as the answer; each effect borrows it
; to pick the replayed-or-live value, then advances it once with `drop`.
[fn run-resume [journal]
  [[handle
    [agent 0 "start"]
    [return x]
    [fn [j] x]
    [Llm.complete p]
    [fn [j]
      [let v [if [empty? j] [live-llm p] [nth j 0]]]
      [[resume v] [drop 1 j]]]
    [Tool.call t]
    [fn [j]
      [let v [if [empty? j] [live-tool t] [nth j 0]]]
      [[resume v] [drop 1 j]]]
    [Log.info m]
    [fn [j] [[resume []] j]]]
    journal]]

[fn main []
  [println [str "live:            " [run-live]]]
  ; full journal → reconstructs the whole run with no live steps
  [println
    [str
      "resume (full):   "
      [run-resume #["search" "3-hits" "summarize" "summary" "done"]]]]
  ; journal truncated by a crash after step 0 → replays the prefix, then live
  [println [str "resume (crashed):" [run-resume #["search" "3-hits"]]]]]
