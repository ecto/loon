; ───────────────────────────────────────────────────────────────────────────
; Cooperative scheduler as an effect handler — INTERLEAVED multi-shot.
;
; `Co.fork` returns true in the parent and false in a freshly-spawned child
; (Unix-style); `Co.yield` cooperatively hands off. The scheduler is a handler
; that threads a run-queue of continuations as its answer; `resume` is a
; first-class, multi-shot continuation captured at each fork/yield.
;
; This is the async substrate the agent framework's retry/cancellation handlers
; wrap. It RUNS correctly on the default EIR VM — interleaved, re-entrant
; continuations work (an earlier "BUG-6" was a bug in the test harness, not the
; VM: `drop` is count-first `[drop n coll]`). See src/eff/NOTES.md.
;
; Note: it does not yet `loon check` — the answer type is genuinely recursive
; (Queue = Vec of (Queue -> Unit)), which Hindley-Milner rejects without a
; nominal/iso-recursive wrapper. The runtime is unaffected.
;
; Run: loon run src/eff/scheduler.oo
; ───────────────────────────────────────────────────────────────────────────
[effect Co
  [fork [] Bool]
  [yield [] Unit]]

; The run-queue is a vector of resumptions (each a function of the queue).
; run-next pops the head and runs it with the remaining queue.
[fn run-next [q] [if [empty? q] [] [do [let k [nth q 0]] [k [drop 1 q]]]]]

; The scheduler handler. `fork` resumes the parent immediately (true) and
; enqueues the child (false); `yield` enqueues the current continuation and
; runs the next ready task. The whole thing is applied to an empty queue.
[fn scheduler [entry]
  [[handle
    [entry]
    [return _]
    [fn [q] [run-next q]]
    [Co.yield]
    [fn [q] [run-next [conj q [fn [qp] [[resume []] qp]]]]]
    [Co.fork]
    [fn [q] [[resume true] [conj q [fn [qp] [[resume false] qp]]]]]]
    #[]]]

; Two workers, each yielding twice — they interleave round-robin.
[fn worker [tag]
  [println [str tag " step 1"]]
  [Co.yield]
  [println [str tag " step 2"]]
  [Co.yield]
  [println [str tag " step 3"]]]

[fn main [] [scheduler [fn [] [if [Co.fork] [worker "A"] [worker "B"]]]]]
; A step 1 / B step 1 / A step 2 / B step 2 / A step 3 / B step 3
