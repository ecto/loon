[fn decide [src] [if [checks? src] "accept" "reject"]]
[fn main []
  [println [decide "[fn main [] [+ 1 2]]"]]
  [println [decide "[fn add [a b] [+ a b]] [fn main [] [add 1 2]]"]]
  [println [decide "[fn id [x] x] [fn main [] [if [id true] [id 1] [id 2]]]"]]
  [println [decide "[type Opt [Some Int] [None]] [fn main [] [Some 1]]"]]
  [println [decide "[fn main [] [+ 1 \"x\"]]"]]
  [println [decide "[fn main [] [if true 1 \"x\"]]"]]
  [println [decide "[fn main [] [str \"a\" \"b\"]]"]]]
