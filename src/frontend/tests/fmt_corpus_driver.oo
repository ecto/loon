; Stage-1 corpus driver: fmt idempotence + round-trip across the repo corpus.
; Concatenated after reader.oo + formatter.oo + generated `corpus-files`.

[fn fstatus [src]
  [if [= [len src] 0]
    :empty
    [if [had-error [canon src]]
      :readerr
      [check-fmt src]]]]

[fn check-fmt [src]
  [if [streq [fmt src] [fmt [fmt src]]]
    [if [streq [canon [fmt src]] [canon src]]
      :ok
      :not-roundtrip]
    :not-idempotent]]

[fn step [tally path]
  [let s [fstatus [IO.read-file path]]]
  [do
    [if [= s :ok] :silent [println [str "  " s "  " path]]]
    #[[+ [nth tally 0] [if [= s :ok] 1 0]]
      [+ [nth tally 1] [if [= s :not-idempotent] 1 0]]
      [+ [nth tally 2] [if [= s :not-roundtrip] 1 0]]
      [+ [nth tally 3] [if [if [= s :empty] true [= s :readerr]] 1 0]]]]]

[fn main []
  [let files [corpus-files]]
  [println [str "Stage-1 fmt corpus: " [len files] " files"]]
  [let t [fold #[0 0 0 0] step files]]
  [println [str "ok=" [nth t 0] " not-idempotent=" [nth t 1]
                " not-roundtrip=" [nth t 2] " skipped=" [nth t 3]]]
  [if [= [+ [nth t 1] [nth t 2]] 0]
    [println "GATE 1+2: PASS"]
    [println "GATE 1+2: FAIL"]]]
