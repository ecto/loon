; Stage-3e/3f inline tests. Concatenated after reader.oo + eir.oo + lower.oo +
; vm.oo. Validates lowering well-formedness (3e) and VM execution (3f) on a
; self-contained set of subset programs.

[fn report [name ok] [println [str [if ok "  pass " "  FAIL "] name]]]
[fn run1 [src] [display [eir-run-str src]]]
[fn evals [name src want] [report name [streq [run1 src] want]]]
[fn wf [name src] [report name [eir-wf? [lower-program [read-all src]]]]]

[fn main []
  [println "Stage-3e/3f EIR backend — inline tests"]

  ; ── lowering well-formedness ──
  [wf "wf arith"  "[fn main [] [+ 1 2]]"]
  [wf "wf if"     "[fn main [] [if [< 1 2] 1 2]]"]
  [wf "wf fib"    "[fn fib [n] [if [< n 2] n [+ [fib [- n 1]] [fib [- n 2]]]]] [fn main [] [fib 5]]"]

  ; ── VM execution (value of main) ──
  [evals "literal"   "[fn main [] 42]" "42"]
  [evals "arith"     "[fn main [] [- [* 6 7] 0]]" "42"]
  [evals "nested"    "[fn main [] [- [* 10 10] [+ 1 2]]]" "97"]
  [evals "neg lit"   "[fn main [] [+ -5 7]]" "2"]
  [evals "if true"   "[fn main [] [if [< 1 2] 111 222]]" "111"]
  [evals "if false"  "[fn main [] [if [> 1 2] 111 222]]" "222"]
  [evals "let"       "[fn main [] [let x 5] [let y 6] [* x y]]" "30"]
  [evals "shadow"    "[fn main [] [let x 1] [let x 2] x]" "2"]
  [evals "bool eq"   "[fn main [] [if [= 3 3] 1 0]]" "1"]
  [evals "not"       "[fn main [] [if [not [< 2 1]] 7 8]]" "7"]
  [evals "str"       "[fn main [] [str \"a\" \"b\" \"c\"]]" "abc"]
  [evals "call"      "[fn dbl [n] [* n 2]] [fn main [] [dbl 21]]" "42"]
  [evals "recursion" "[fn fib [n] [if [< n 2] n [+ [fib [- n 1]] [fib [- n 2]]]]] [fn main [] [fib 10]]" "55"]
  [evals "factorial" "[fn fact [n] [if [< n 2] 1 [* n [fact [- n 1]]]]] [fn main [] [fact 5]]" "120"]

  ; ── match (literal + var/wildcard patterns) ──
  [evals "match int lit" "[fn f [n] [match n 0 \"zero\" 1 \"one\" n \"many\"]] [fn main [] [f 1]]" "one"]
  [evals "match var arm" "[fn f [n] [match n 0 \"zero\" 1 \"one\" n \"many\"]] [fn main [] [f 7]]" "many"]
  [evals "match binds"   "[fn f [n] [match n 0 100 m [* m m]]] [fn main [] [f 9]]" "81"]
  [evals "match wildcard" "[fn f [n] [match n 0 \"z\" _ \"nz\"]] [fn main [] [f 5]]" "nz"]
  [evals "match str"     "[fn f [s] [match s \"hi\" 1 \"bye\" 2 _ 0]] [fn main [] [f \"bye\"]]" "2"]
  [evals "fib via match" "[fn fib [n] [match n 0 0 1 1 n [+ [fib [- n 1]] [fib [- n 2]]]]] [fn main [] [fib 10]]" "55"]

  ; ── collections + string builtins ──
  [evals "vec literal"  "[fn main [] #[1 2 3]]" "#[1 2 3]"]
  [evals "len vec"      "[fn main [] [len #[1 2 3]]]" "3"]
  [evals "len str"      "[fn main [] [len \"abc\"]]" "3"]
  [evals "nth"          "[fn main [] [nth #[10 20 30] 1]]" "20"]
  [evals "conj+join"    "[fn main [] [join \",\" [conj #[\"a\" \"b\"] \"c\"]]]" "a,b,c"]
  [evals "join"         "[fn main [] [join \"-\" #[\"x\" \"y\" \"z\"]]]" "x-y-z"]
  [evals "split len"    "[fn main [] [len [split \"a.b.c\" \".\"]]]" "3"]
  [evals "index-of"     "[fn main [] [index-of \"hello\" \"ll\"]]" "2"]
  [evals "slice+join"   "[fn main [] [join \",\" [slice #[\"a\" \"b\" \"c\" \"d\"] 1 3]]]" "b,c"]
  [evals "sum over vec"
    "[fn sum [v i acc] [if [>= i [len v]] acc [sum v [+ i 1] [+ acc [nth v i]]]]] [fn main [] [sum #[1 2 3 4 5] 0 0]]"
    "15"]

  ; ── ADT values + constructor patterns ──
  [evals "Some unwrap"  "[fn f [o] [match o [Some n] n [None] -1]] [fn main [] [f [Some 42]]]" "42"]
  [evals "None arm"     "[fn f [o] [match o [Some n] n [None] -1]] [fn main [] [f [None]]]" "-1"]
  [evals "ctor display" "[fn main [] [Some 7]]" "[Some 7]"]
  [evals "nullary disp" "[fn main [] [None]]" "[None]"]
  [evals "two fields"   "[fn fst [p] [match p [Pair a b] a]] [fn main [] [fst [Pair 11 22]]]" "11"]
  [evals "list sum"
    "[fn s [xs] [match xs [Cons h t] [+ h [s t]] [Nil] 0]] [fn main [] [s [Cons 1 [Cons 2 [Cons 3 [Nil]]]]]]"
    "6"]
  [evals "ctor in body"
    "[fn box [n] [Some n]] [fn main [] [match [box 5] [Some x] [* x x] [None] 0]]" "25"]

  [println "done"]]
