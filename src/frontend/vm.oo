; Loon self-hosted frontend — Stage 3f: the self-hosted EIR VM.
;
; Concatenated after reader.oo + eir.oo + lower.oo. Executes a lowered Module: a
; register machine that dispatches basic blocks, runs each block's ops against a
; register file, and follows the terminator. Calls push a new frame (a fresh
; register file), so recursion works. This is the runtime that makes the backend
; behaviorally checkable against `loon run` (F1) — see run-eir-diff.sh.
;
; Scope matches lower.oo's first slice: int/float/string/bool values, primitive
; operators, user calls/recursion, if-branching. Multi-shot continuations (D3),
; closures, collections, and effects are later VM increments.

; ── Runtime values ───────────────────────────────────────────────────────────

[type Val
  [VInt i64]
  [VFloat String]      ; kept as lexeme (no float arithmetic in this slice)
  [VStr String]
  [VBool Bool]
  [VKw String]         ; keyword (:name, stored without colon)
  [VVec Vec]           ; vector of Vals
  [VMap Vec]           ; map: flat assoc vector #[k0 v0 k1 v1 …]
  [VSet Vec]           ; set: vector of (unique) elements
  [VAdt String Vec]    ; constructor value: tag + fields
  [VClosure i64 Vec]   ; closure: function index + captured values
  [VUnit]]

[fn vint [v] [match v [VInt i] i _ 0]]
[fn vstr [v] [match v [VStr s] s _ [display v]]]
[fn vvec [v] [match v [VVec xs] xs _ #[]]]
[fn adt-tag [v] [match v [VAdt t _] t _ ""]]
[fn adt-field [v i] [match v [VAdt _ fs] [nth fs i] _ [VUnit]]]
[fn truthy [v] [match v [VBool b] b [VUnit] false _ true]]

[fn display [v]
  [match v
    [VInt i]   [str i]
    [VFloat s] s
    [VStr s]   s
    [VBool b]  [if b "true" "false"]
    [VKw n]    [str ":" n]
    [VVec xs]  [str "#[" [join " " [map-display-vec xs]] "]"]
    [VMap kvs] [str "\{" [join " " [map-display-vec kvs]] "}"]
    [VSet es]  [str "#\{" [join " " [map-display-vec es]] "}"]
    [VAdt t fs] [if [= [len fs] 0] [str "[" t "]"]
                  [str "[" t " " [join " " [map-display-vec fs]] "]"]]
    [VClosure _ _] "#<closure>"
    [VUnit]    "()"]]

[fn map-display-vec [xs]
  [loop [k 0 acc #[]]
    [if [>= k [len xs]] acc [recur [+ k 1] [conj acc [display [nth xs k]]]]]]]

[fn display-all [vals]
  [loop [k 0 acc #[]]
    [if [>= k [len vals]] [join "" acc]
      [recur [+ k 1] [conj acc [display [nth vals k]]]]]]]

; ── Integer literal parsing (no string->int builtin exists) ──────────────────

[fn digit-val [c] [index-of "0123456789" c]]

[fn parse-int [s]
  [let cv [to-chars s]]
  [let neg [if [> [len cv] 0] [streq [nth cv 0] "-"] false]]
  [let n
    [loop [k [if neg 1 0] acc 0]
      [if [>= k [len cv]] acc
        [recur [+ k 1] [+ [* acc 10] [digit-val [nth cv k]]]]]]]
  [if neg [- 0 n] n]]

; ── Register file ─────────────────────────────────────────────────────────────

[fn make-regs [n params]
  [loop [k 0 acc #[]]
    [if [>= k n] acc
      [recur [+ k 1] [conj acc [if [< k [len params]] [nth params k] [VUnit]]]]]]]

[fn vset [v i x]
  [loop [k 0 acc #[]]
    [if [>= k [len v]] acc [recur [+ k 1] [conj acc [if [= k i] x [nth v k]]]]]]]

[fn gather [regs args]
  [loop [k 0 acc #[]]
    [if [>= k [len args]] acc [recur [+ k 1] [conj acc [nth regs [nth args k]]]]]]]

; ── Primitives ────────────────────────────────────────────────────────────────

[fn arith? [nm] [eir-member nm #["+" "-" "*" "/"]]]
[fn cmp?   [nm] [eir-member nm #["<" ">" "<=" ">=" "="]]]

[fn coll? [nm]
  [eir-member nm
    #["len" "nth" "conj" "join" "split" "index-of" "slice"
      "get" "assoc" "keys" "contains?"]]]

[fn apply-prim [nm vals]
  [if [arith? nm] [apply-arith nm [vint [nth vals 0]] [vint [nth vals 1]]]
    [if [cmp? nm] [apply-cmp nm vals]
      [if [coll? nm] [apply-coll nm vals]
        [if [streq nm "not"] [VBool [not [truthy [nth vals 0]]]]
          [if [streq nm "println"] [do [println [display [nth vals 0]]] [VUnit]]
            [if [streq nm "print"] [do [print [display [nth vals 0]]] [VUnit]]
              [if [streq nm "str"] [VStr [display-all vals]]
                [VUnit]]]]]]]]]

; Collection / string builtins, delegated to the host builtins on the unwrapped
; loon values so semantics match `loon run` exactly.
[fn apply-coll [nm vals]
  [if [streq nm "len"] [VInt [coll-len [nth vals 0]]]
    [if [streq nm "nth"] [nth [vvec [nth vals 0]] [vint [nth vals 1]]]
      [if [streq nm "conj"] [VVec [conj [vvec [nth vals 0]] [nth vals 1]]]
        [if [streq nm "slice"]
          [VVec [slice [vvec [nth vals 0]] [vint [nth vals 1]] [vint [nth vals 2]]]]
          [if [streq nm "join"]
            [VStr [join [vstr [nth vals 0]] [map-display-vec [vvec [nth vals 1]]]]]
            [if [streq nm "split"]
              [VVec [wrap-strs [split [vstr [nth vals 0]] [vstr [nth vals 1]]]]]
              [if [streq nm "index-of"]
                [VInt [index-of [vstr [nth vals 0]] [vstr [nth vals 1]]]]
                [apply-map nm vals]]]]]]]]]

; Map / set operations (maps are flat assoc vectors; lookup uses val-eq, so
; keyword/int/string keys all work regardless of host map semantics).
[fn apply-map [nm vals]
  [if [streq nm "get"] [map-get [nth vals 0] [nth vals 1]]
    [if [streq nm "assoc"] [VMap [assoc-kvs [vkvs [nth vals 0]] [nth vals 1] [nth vals 2]]]
      [if [streq nm "keys"] [VVec [map-keys [vkvs [nth vals 0]]]]
        [if [streq nm "contains?"] [VBool [coll-has [nth vals 0] [nth vals 1]]]
          [VUnit]]]]]]

[fn vkvs [v] [match v [VMap kvs] kvs _ #[]]]

[fn map-get [m k]
  [match m
    [VMap kvs]
    [loop [i 0]
      [if [>= i [len kvs]] [VUnit]
        [if [val-eq [nth kvs i] k] [nth kvs [+ i 1]] [recur [+ i 2]]]]]
    _ [VUnit]]]

[fn assoc-kvs [kvs k v]
  [loop [i 0 acc #[] done false]
    [if [>= i [len kvs]]
      [if done acc [conj [conj acc k] v]]
      [if [val-eq [nth kvs i] k]
        [recur [+ i 2] [conj [conj acc k] v] true]
        [recur [+ i 2] [conj [conj acc [nth kvs i]] [nth kvs [+ i 1]]] done]]]]]

[fn map-keys [kvs]
  [loop [i 0 acc #[]]
    [if [>= i [len kvs]] acc [recur [+ i 2] [conj acc [nth kvs i]]]]]]

; contains?: maps test keys; sets and vectors test membership.
[fn coll-has [c x]
  [match c
    [VMap kvs] [loop [i 0] [if [>= i [len kvs]] false [if [val-eq [nth kvs i] x] true [recur [+ i 2]]]]]
    [VSet es]  [elem? es x]
    [VVec es]  [elem? es x]
    _ false]]

[fn elem? [es x]
  [loop [k 0] [if [>= k [len es]] false [if [val-eq [nth es k] x] true [recur [+ k 1]]]]]]

[fn coll-len [v]
  [match v
    [VVec xs] [len xs] [VStr s] [len s]
    [VMap kvs] [/ [len kvs] 2] [VSet es] [len es] _ 0]]

; Wrap a host vector of loon strings as a VVec of VStr.
[fn wrap-strs [xs]
  [loop [k 0 acc #[]]
    [if [>= k [len xs]] acc [recur [+ k 1] [conj acc [VStr [nth xs k]]]]]]]

[fn apply-arith [nm a b]
  [if [streq nm "+"] [VInt [+ a b]]
    [if [streq nm "-"] [VInt [- a b]]
      [if [streq nm "*"] [VInt [* a b]]
        [VInt [/ a b]]]]]]

[fn apply-cmp [nm vals]
  [let a [vint [nth vals 0]]]
  [let b [vint [nth vals 1]]]
  [if [streq nm "<"] [VBool [< a b]]
    [if [streq nm ">"] [VBool [> a b]]
      [if [streq nm "<="] [VBool [<= a b]]
        [if [streq nm ">="] [VBool [>= a b]]
          [VBool [val-eq [nth vals 0] [nth vals 1]]]]]]]]

[fn val-eq [x y]
  [match x
    [VInt a]  [match y [VInt b] [= a b] _ false]
    [VBool a] [match y [VBool b] [= a b] _ false]
    [VStr a]  [match y [VStr b] [streq a b] _ false]
    [VKw a]   [match y [VKw b] [streq a b] _ false]
    [VAdt at af] [match y [VAdt bt bf] [if [streq at bt] [vals-eq af bf] false] _ false]
    [VUnit]   [match y [VUnit] true _ false]
    _ false]]

[fn vals-eq [as bs]
  [if [= [len as] [len bs]]
    [loop [k 0]
      [if [>= k [len as]] true
        [if [val-eq [nth as k] [nth bs k]] [recur [+ k 1]] false]]]
    false]]

; ── Execution ─────────────────────────────────────────────────────────────────
;
; A dynamic handler stack is threaded through execution (exec-func ->
; run-blocks -> exec-ops) and along the executed block path, so installed
; handlers are visible to perform sites in the body and in any function it
; calls. exec-ops returns both the register file and the (possibly updated)
; handler stack via ER, since OHandlePush/OHandlePop mutate it.
[type ER [ER Vec Vec]]    ; registers, handler stack

[fn exec-func [funcs func args handlers]
  [match func [Func _ _ nr blocks]
    [run-blocks funcs blocks [make-regs nr args] handlers 0]]]

[fn run-blocks [funcs blocks regs handlers id]
  [match [eir-find-block blocks id]
    :none [VUnit]
    blk [run-block funcs blocks blk regs handlers]]]

[fn run-block [funcs blocks blk regs handlers]
  [match blk [Block _ ops term]
    [match [exec-ops funcs regs handlers ops]
      [ER regs2 handlers2] [run-term funcs blocks term regs2 handlers2]]]]

[fn run-term [funcs blocks term regs handlers]
  [match term
    [TRet r] [nth regs r]
    [TBr b] [run-blocks funcs blocks regs handlers b]
    [TBrIf c a b] [run-blocks funcs blocks regs handlers [if [truthy [nth regs c]] a b]]]]

[fn exec-ops [funcs regs handlers ops]
  [loop [k 0 regs regs handlers handlers]
    [if [>= k [len ops]] [ER regs handlers]
      [match [exec-op funcs regs handlers [nth ops k]]
        [ER r2 h2] [recur [+ k 1] r2 h2]]]]]

[fn exec-op [funcs regs handlers op]
  [match op
    [OInt d lex]   [ER [vset regs d [VInt [parse-int lex]]] handlers]
    [OFloat d lex] [ER [vset regs d [VFloat lex]] handlers]
    [OStr d v]     [ER [vset regs d [VStr v]] handlers]
    [OBool d b]    [ER [vset regs d [VBool b]] handlers]
    [OKw d n]      [ER [vset regs d [VKw n]] handlers]
    [OUnit d]      [ER [vset regs d [VUnit]] handlers]
    [OMove d s]    [ER [vset regs d [nth regs s]] handlers]
    [OVec d args]  [ER [vset regs d [VVec [gather regs args]]] handlers]
    [OMap d args]  [ER [vset regs d [VMap [gather regs args]]] handlers]
    [OSet d args]  [ER [vset regs d [VSet [gather regs args]]] handlers]
    [OAdt d ctor args] [ER [vset regs d [VAdt ctor [gather regs args]]] handlers]
    [OTag d s]     [ER [vset regs d [VStr [adt-tag [nth regs s]]]] handlers]
    [OField d s ix] [ER [vset regs d [adt-field [nth regs s] ix]] handlers]
    [OPrim d nm args] [ER [vset regs d [apply-prim nm [gather regs args]]] handlers]
    [OCall d fi args] [ER [vset regs d [exec-func funcs [nth funcs fi] [gather regs args] handlers]] handlers]
    [OPerform d nm args] [ER [vset regs d [perform funcs handlers nm [gather regs args]]] handlers]
    [OHandlePush frame] [ER regs [conj handlers frame]]
    [OHandlePop] [ER regs [slice handlers 0 [- [len handlers] 1]]]
    [OClosure d fi caps] [ER [vset regs d [VClosure fi [gather regs caps]]] handlers]
    [OCallV d fr args] [ER [vset regs d [call-closure funcs [nth regs fr] [gather regs args] handlers]] handlers]]]

; Call a closure: prepend its captured values to the arguments and invoke its
; function (the lifted function's leading parameters are the captures).
[fn call-closure [funcs cval args handlers]
  [match cval
    [VClosure fi caps] [exec-func funcs [nth funcs fi] [vapp caps args] handlers]
    _ [VUnit]]]

[fn vapp [a b]
  [loop [k 0 acc a] [if [>= k [len b]] acc [recur [+ k 1] [conj acc [nth b k]]]]]]

; Perform an effect operation: find the innermost handler for it and call its
; (synthetic) handler function with the operation arguments. Tail-resumptive —
; the handler's return value IS the perform's result (resume is the identity).
[fn perform [funcs handlers nm vals]
  [let fi [find-handler handlers nm]]
  [if [< fi 0]
    [VUnit]                                       ; unhandled effect: unit
    [exec-func funcs [nth funcs fi] vals handlers]]]

[fn find-handler [handlers nm]
  [loop [fk [- [len handlers] 1]]
    [if [< fk 0] -1
      [if [>= [find-in-frame [nth handlers fk] nm] 0]
        [find-in-frame [nth handlers fk] nm]
        [recur [- fk 1]]]]]]

[fn find-in-frame [frame nm]
  [loop [k 0]
    [if [>= k [len frame]] -1
      [match [nth frame k] [HE op fi] [if [streq op nm] fi [recur [+ k 1]]]]]]]

; ── Entry points ──────────────────────────────────────────────────────────────

[fn find-main [funcs]
  [loop [k 0]
    [if [>= k [len funcs]] :none
      [match [nth funcs k] [Func nm _ _ _] [if [streq nm "main"] k [recur [+ k 1]]]]]]]

[fn run-module [m]
  [match m [Module funcs]
    [match [find-main funcs] :none [VUnit] mi [exec-func funcs [nth funcs mi] #[] #[]]]]]

; Lower a program (vector of Forms) to EIR and run it; returns main's value.
[fn eir-run [forms] [run-module [lower-program forms]]]

; Read + lower + run a source string.
[fn eir-run-str [src] [eir-run [read-all src]]]
