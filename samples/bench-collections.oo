; Loon collection benchmark suite
; Run with: time cargo run -p loon-cli -- run samples/bench-collections.oo

; --- 1. Vec append: build 100,000-element vector via repeated conj ---
[fn bench-vec-append [n]
  [loop [v #[] i 0]
    [if [>= i n] v
      [recur [conj v i] [+ i 1]]]]]

[let v1 [bench-vec-append 100000]]
[IO.println [str "vec-append(100K): len=" [len v1]]]

; --- 2. Vec prepend: build vector via repeated cons ---
[fn bench-vec-prepend [n]
  [loop [v #[] i 0]
    [if [>= i n] v
      [recur [cons i v] [+ i 1]]]]]

[let v2 [bench-vec-prepend 100000]]
[IO.println [str "vec-prepend(100K): len=" [len v2]]]

; --- 3. Map insert: build 100,000-entry map via repeated assoc ---
[fn bench-map-insert [n]
  [loop [m {} i 0]
    [if [>= i n] m
      [recur [assoc m [str "k" i] i] [+ i 1]]]]]

[let m1 [bench-map-insert 100000]]
[IO.println [str "map-insert(100K): len=" [len m1]]]

; --- 4. Map lookup: look up 1000 keys ---
[fn bench-map-lookup [m n]
  [loop [sum 0 i 0]
    [if [>= i n] sum
      [recur [+ sum [get m [str "k" i]]] [+ i 1]]]]]

[let sum [bench-map-lookup m1 1000]]
[IO.println [str "map-lookup(1000): sum=" sum]]

; --- 5. Filter large vec (before clone-mutate moves v1 away) ---
[let filtered [filter [fn [x] [> x 50000]] v1]]
[IO.println [str "filter(100K): len=" [len filtered]]]

; --- 6. Vec clone + mutate ---
[fn bench-clone-mutate [v n]
  [loop [i 0]
    [if [>= i n] :done
      [do
        [let v2 [conj v 999]]
        [recur [+ i 1]]]]]]

[bench-clone-mutate v1 1000]
[IO.println "clone-mutate(1000): done"]

; --- 7. Map merge: merge two 1000-entry maps ---
[fn bench-map-merge [n]
  [fn build [prefix n]
    [loop [m {} i 0]
      [if [>= i n] m
        [recur [assoc m [str prefix i] i] [+ i 1]]]]]
  [let a [build "a" n]]
  [let b [build "b" n]]
  [merge a b]]

[let merged [bench-map-merge 1000]]
[IO.println [str "map-merge(1K+1K): len=" [len merged]]]

[IO.println "bench complete"]
