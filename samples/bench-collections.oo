; Loon collection benchmark suite
; Run with: time cargo run -p loon-cli -- run samples/bench-collections.oo

; --- 1. Vec append: build 200-element vector via repeated conj ---
[fn bench-vec-append [n]
  [fn loop [v i]
    [if [>= i n] v
      [loop [conj v i] [+ i 1]]]]
  [loop #[] 0]]

[let v1 [bench-vec-append 200]]
[IO.println [str "vec-append(200): len=" [len v1]]]

; --- 2. Vec prepend: build vector via repeated cons ---
[fn bench-vec-prepend [n]
  [fn loop [v i]
    [if [>= i n] v
      [loop [cons i v] [+ i 1]]]]
  [loop #[] 0]]

[let v2 [bench-vec-prepend 200]]
[IO.println [str "vec-prepend(200): len=" [len v2]]]

; --- 3. Map insert: build 200-entry map via repeated assoc ---
[fn bench-map-insert [n]
  [fn loop [m i]
    [if [>= i n] m
      [loop [assoc m [str "k" i] i] [+ i 1]]]]
  [loop {} 0]]

[let m1 [bench-map-insert 200]]
[IO.println [str "map-insert(200): len=" [len m1]]]

; --- 4. Map lookup: look up 200 keys ---
[fn bench-map-lookup [m n]
  [fn loop [sum i]
    [if [>= i n] sum
      [loop [+ sum [get m [str "k" i]]] [+ i 1]]]]
  [loop 0 0]]

[let sum [bench-map-lookup m1 200]]
[IO.println [str "map-lookup(200): sum=" sum]]

; --- 5. Vec clone + mutate ---
[fn bench-clone-mutate [v n]
  [fn loop [i]
    [if [>= i n] :done
      [do
        [let v2 [conj v 999]]
        [loop [+ i 1]]]]]
  [loop 0]]

[bench-clone-mutate v1 100]
[IO.println "clone-mutate(100): done"]

; --- 6. Filter large vec ---
[let filtered [filter [fn [x] [> x 100]] v1]]
[IO.println [str "filter(200): len=" [len filtered]]]

; --- 7. Map merge: merge two 100-entry maps ---
[fn bench-map-merge [n]
  [fn build [prefix n]
    [fn loop [m i]
      [if [>= i n] m
        [loop [assoc m [str prefix i] i] [+ i 1]]]]
    [loop {} 0]]
  [let a [build "a" n]]
  [let b [build "b" n]]
  [merge a b]]

[let merged [bench-map-merge 100]]
[IO.println [str "map-merge(100+100): len=" [len merged]]]

[IO.println "bench complete"]
